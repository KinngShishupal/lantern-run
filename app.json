{
  "expo": {
    "name": "lantern-run",
    "slug": "lantern-run",
    "version": "1.0.0",
    "orientation": "landscape",
    "ios": {
      "requireFullScreen": true
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
